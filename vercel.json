{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "backend/**",
      "excludeFiles": "{node_modules/**,src/**,docs/**,public/**,dist/**,backend/tests/**,backend/**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path((?!assets/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/lead-monitoring", "schedule": "0 8 * * *" },
    { "path": "/api/cron/lead-follow-ups", "schedule": "0 9 * * *" },
    { "path": "/api/cron/profile-completion-reminders", "schedule": "0 9 * * *" },
    { "path": "/api/cron/governance-email-queue", "schedule": "* * * * *" },
    { "path": "/api/cron/board-engagement", "schedule": "0 9 * * 1,3,5" },
    { "path": "/api/cron/board-document-reminders", "schedule": "0 8 * * *" }
  ]
}
