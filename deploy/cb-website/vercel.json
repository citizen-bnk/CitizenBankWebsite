{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {"source": "/:path((?!api(?:/|$)).*)", "destination": "https://citizenbank.co.ls/:path", "permanent": false}
  ],
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://citizenbank.co.ls/api/:path*"}
  ]
}
